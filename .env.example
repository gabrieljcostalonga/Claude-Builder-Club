# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=

# Pluggy (dashboard.pluggy.ai > Applications)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo aleatório incluído na URL do webhook (?secret=...)
PLUGGY_WEBHOOK_SECRET=
# true para mostrar o conector sandbox "Pluggy Bank" no widget
NEXT_PUBLIC_PLUGGY_INCLUDE_SANDBOX=true

# Protege /api/cron/sync (Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# URL pública do app (usada no webhook e no callback de e-mail)
APP_URL=http://localhost:3000
